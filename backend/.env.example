NODE_ENV=development
PORT=5000

# Database
DATABASE_URL=postgresql://neuralpost:secret@localhost:5432/neuralpost

# Redis
REDIS_URL=redis://localhost:6379

# JWT Secrets — generate with: openssl rand -base64 64
JWT_SECRET=your-jwt-secret-at-least-64-chars
JWT_REFRESH_SECRET=your-jwt-refresh-secret-at-least-64-chars
JWT_EXPIRES_IN=3000m
JWT_REFRESH_EXPIRES_IN=365d

# Hugging Face (free) — https://huggingface.co/settings/tokens
HF_API_KEY=hf_your_token_here

# Groq (recommended for AI features) — https://console.groq.com/keys
GROQ_API_KEY=gsk_your_key_here

# Google Gemini (optional) — https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_key_here

# The Guardian (optional, for RAG post generation) — https://open-platform.theguardian.com
GUARDIAN_API_KEY=your_guardian_key_here

# Tavily (optional, for web search context) — https://app.tavily.com
TAVILY_API_KEY=tvly_your_key_here

# Cloudinary (optional, for image uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000
